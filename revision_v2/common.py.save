from pathlib import Path
import shutil


# ============================================================
# PROJECT PATHS
# ============================================================

# common.py is located at:
# thesis_project/revision_v2/common.py
#
# Therefore parents[1] is:
# thesis_project/
PROJECT_ROOT = Path(__file__).resolve().parents[1]

NETWORK_DIR = PROJECT_ROOT / "network"
ROUTES_DIR = PROJECT_ROOT / "routes"

RESULTS_V2_DIR = PROJECT_ROOT / "results_v2"
MODELS_V2_DIR = PROJECT_ROOT / "models_v2"
BASELINES_V2_DIR = PROJECT_ROOT / "baselines_v2"


# ============================================================
# NETWORK FILES
# ============================================================

NETWORK_FILES = {
    "2x2": NETWORK_DIR / "grid2x2" / "grid2x2.net.xml",
    "3x3": NETWORK_DIR / "grid3x3" / "grid3x3.net.xml",
    "4x4": NETWORK_DIR / "grid4x4" / "grid4x4.net.xml",
    "5x5": NETWORK_DIR / "grid5x5" / "grid5x5.net.xml",
}


# ============================================================
# ROUTE FILES
# ============================================================

ROUTE_FILES = {
    ("2x2", "low"): (
        ROUTES_DIR / "grid2x2" / "low_demand.rou.xml"
    ),

    ("2x2", "medium"): (
        ROUTES_DIR / "grid2x2" / "medium_demand.rou.xml"
    ),

    ("2x2", "high"): (
        ROUTES_DIR / "grid2x2" / "high_demand.rou.xml"
    ),

    ("2x2", "dynamic"): (
        ROUTES_DIR / "grid2x2" / "dynamic_demand.rou.xml"
    ),

    ("3x3", "medium"): (
        ROUTES_DIR / "grid3x3" / "medium_demand.rou.xml"
    ),

    ("4x4", "medium"): (
        ROUTES_DIR / "grid4x4" / "medium_demand.rou.xml"
    ),

    ("5x5", "medium"): (
        ROUTES_DIR / "grid5x5" / "medium_demand.rou.xml"
    ),
}


# ============================================================
# EXPERIMENT CONFIGURATION
# ============================================================

GRID_AGENT_COUNTS = {
    "2x2": 4,
    "3x3": 9,
    "4x4": 16,
    "5x5": 25,
}

PRIMARY_SCENARIOS = [
    "low",
    "medium",
    "high",
    "dynamic",
]

SCALABILITY_GRIDS = [
    "2x2",
    "3x3",
    "4x4",
    "5x5",
]

SCALABILITY_SCENARIO = "medium"

SIMULATION_DURATION_SECONDS = 1800

SIMULATION_STEP_SECONDS = 1

AGENT_DECISION_INTERVAL_SECONDS = 5

YELLOW_DURATION_SECONDS = 3


# ============================================================
# SUMO EXECUTABLES
# ============================================================

SUMO_BINARY = shutil.which("sumo")
SUMO_GUI_BINARY = shutil.which("sumo-gui")


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def get_network_file(grid: str) -> Path:
    """
    Return the SUMO .net.xml file for the requested grid.
    """

    if grid not in NETWORK_FILES:
        valid = ", ".join(NETWORK_FILES.keys())
        raise ValueError(
            f"Unknown grid '{grid}'. "
            f"Valid grids: {valid}"
        )

    return NETWORK_FILES[grid]


def get_route_file(grid: str, scenario: str) -> Path:
    """
    Return the route file for the requested grid/scenario.
    """

    key = (grid, scenario)

    if key not in ROUTE_FILES:
        available = "\n".join(
            f"  {g} / {s}"
            for g, s in ROUTE_FILES.keys()
        )

        raise ValueError(
            f"No route file configured for "
            f"grid='{grid}', scenario='{scenario}'.\n"
            f"Available combinations:\n{available}"
        )

    return ROUTE_FILES[key]


def ensure_output_directories():
    """
    Create the revision output directories without touching
    the original thesis results/models directories.
    """

    RESULTS_V2_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    MODELS_V2_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    BASELINES_V2_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )


def validate_project_files():
    """
    Verify that every expected network and route file exists.
    """

    missing = []

    for grid, path in NETWORK_FILES.items():
        if not path.exists():
            missing.append(
                f"NETWORK {grid}: {path}"
            )

    for (grid, scenario), path in ROUTE_FILES.items():
        if not path.exists():
            missing.append(
                f"ROUTE {grid}/{scenario}: {path}"
            )

    if missing:
        print("\nERROR: Some required project files are missing:\n")

        for item in missing:
            print(f"  - {item}")

        raise FileNotFoundError(
            "Project structure validation failed."
        )

    print("All configured network and route files exist.")


def validate_sumo():
    """
    Check whether SUMO is available from the active shell.
    """

    if SUMO_BINARY is None:
        raise RuntimeError(
            "SUMO executable was not found in PATH."
        )

    print(f"SUMO executable: {SUMO_BINARY}")

    if SUMO_GUI_BINARY:
        print(
            f"SUMO-GUI executable: {SUMO_GUI_BINARY}"
        )
    else:
        print(
            "SUMO-GUI was not found. "
            "This is not required for headless experiments."
        )


def print_configuration():
    """
    Display the revision experiment configuration.
    """

    print("\n========================================")
    print("THESIS REVISION V2 CONFIGURATION")
    print("========================================")

    print(f"\nProject root:\n{PROJECT_ROOT}")

    print("\nNetworks:")
    for grid, path in NETWORK_FILES.items():
        print(
            f"  {grid:<4} "
            f"({GRID_AGENT_COUNTS[grid]:>2} agents) "
            f"-> {path}"
        )

    print("\nRoutes:")
    for (grid, scenario), path in ROUTE_FILES.items():
        print(
            f"  {grid:<4} "
            f"{scenario:<8} -> {path}"
        )

    print(
        "\nSimulation duration: "
        f"{SIMULATION_DURATION_SECONDS} s"
    )

    print(
        "Simulation step: "
        f"{SIMULATION_STEP_SECONDS} s"
    )

    print(
        "Agent decision interval: "
        f"{AGENT_DECISION_INTERVAL_SECONDS} s"
    )

    print(
        "Yellow duration: "
        f"{YELLOW_DURATION_SECONDS} s"
    )


# ============================================================
# SELF-TEST
# ============================================================

if __name__ == "__main__":

    print_configuration()

    print("\nChecking project files...")
    validate_project_files()

    print("\nChecking SUMO...")
    validate_sumo()

    print("\nCreating revision output directories...")
    ensure_output_directories()

    print(f"  Results:   {RESULTS_V2_DIR}")
    print(f"  Models:    {MODELS_V2_DIR}")
    print(f"  Baselines: {BASELINES_V2_DIR}")

    print("\n========================================")
    print("PASS: common.py configuration is valid.")
    print("========================================")
